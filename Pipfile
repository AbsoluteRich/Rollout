[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
click = "*"
requests = "*"
halo = {ref = "remove-terminal-check", git = "git+https://github.com/norweeg/halo.git"}
jinja2 = "*"
rollout = {path = ".", editable = true}

[dev-packages]
black = "*"
isort = "*"
flit = "*"
invoke = "*"

[requires]
python_version = "3.12"

[scripts]
pre-commit = "invoke pre-commit"
bump = "invoke bump"
reformat = "invoke reformat"
format = "invoke reformat"
update = "invoke update-dependencies"
